---
type NavItem = {
  href: string;
  label: string;
};

type Props = {
  title?: string;
  items: NavItem[];
};

const { title = "页面导航", items } = Astro.props;
---

<aside
  class="pointer-events-none fixed top-1/2 z-30 hidden -translate-y-1/2 [@media(min-width:1420px)]:block"
  style="right: max(1rem, calc((100vw - 80rem) / 2 - 7.75rem));"
>
  <nav
    class="pointer-events-auto relative w-36 border-l border-border bg-background/72 py-4 pr-2 pl-4 backdrop-blur-sm"
    aria-label={title}
    data-side-nav
  >
    <span
      class="absolute top-4 bottom-4 left-0 border-l border-border"
      aria-hidden="true"></span>
    <span
      class="absolute left-[-1px] w-px bg-accent transition-[height,transform] duration-300 ease-out"
      style="height: var(--marker-h, 28px); transform: translateY(var(--marker-y, 0px));"
      data-side-nav-marker
      aria-hidden="true"></span>

    <p
      class="mb-3 text-[10px] font-semibold tracking-[0.28em] text-accent uppercase"
    >
      Index
    </p>

    <ol class="space-y-1.5">
      {
        items.map((item, index) => (
          <li>
            <a
              href={item.href}
              class="group grid grid-cols-[1.35rem_1fr] items-baseline gap-2 py-1.5 text-sm text-foreground/48 transition hover:text-accent aria-current:text-accent"
              data-side-nav-link
            >
              <span class="font-serif text-xs text-foreground/35 tabular-nums transition group-hover:text-accent group-aria-current:text-accent">
                {String(index + 1).padStart(2, "0")}
              </span>
              <span class="leading-5">{item.label}</span>
            </a>
          </li>
        ))
      }
    </ol>
  </nav>
</aside>

<script is:inline>
  function initSideNav() {
    document.querySelectorAll("[data-side-nav]").forEach(nav => {
      if (nav.dataset.sideNavReady === "true") return;
      nav.dataset.sideNavReady = "true";

      const marker = nav.querySelector("[data-side-nav-marker]");
      const links = Array.from(nav.querySelectorAll("[data-side-nav-link]"));
      const sections = links
        .map(link => {
          const target = document.querySelector(link.hash);
          return target ? { link, target } : null;
        })
        .filter(Boolean);

      let activeLink = links[0];
      let clickedLink = null;
      let clickTimer;

      const movePlane = link => {
        if (!marker || !link) return;
        const linkBox = link.getBoundingClientRect();
        const navBox = nav.getBoundingClientRect();
        const y = linkBox.top - navBox.top;
        nav.style.setProperty("--marker-y", `${y}px`);
        nav.style.setProperty("--marker-h", `${linkBox.height}px`);
      };

      const setActive = link => {
        activeLink?.removeAttribute("aria-current");
        activeLink = link;
        activeLink?.setAttribute("aria-current", "true");
        movePlane(activeLink);
      };

      links.forEach(link => {
        link.addEventListener("click", () => {
          clickedLink = link;
          setActive(link);
          window.clearTimeout(clickTimer);
          clickTimer = window.setTimeout(() => {
            clickedLink = null;
          }, 1200);
        });
        link.addEventListener("mouseenter", () => movePlane(link));
        link.addEventListener("focus", () => movePlane(link));
        link.addEventListener("mouseleave", () => movePlane(activeLink));
        link.addEventListener("blur", () => movePlane(activeLink));
      });

      const observer = new IntersectionObserver(
        entries => {
          const visibleEntry = entries
            .filter(entry => entry.isIntersecting)
            .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];

          if (!visibleEntry) return;
          const current = sections.find(
            section => section.target === visibleEntry.target
          );
          if (clickedLink && current?.link !== clickedLink) return;
          if (clickedLink && current?.link === clickedLink) {
            clickedLink = null;
            window.clearTimeout(clickTimer);
          }
          if (current) setActive(current.link);
        },
        {
          rootMargin: "-35% 0px -50% 0px",
          threshold: [0.1, 0.35, 0.6],
        }
      );

      sections.forEach(section => observer.observe(section.target));
      requestAnimationFrame(() => setActive(activeLink));
      window.addEventListener("resize", () => movePlane(activeLink));
    });
  }

  initSideNav();
  document.addEventListener("astro:page-load", initSideNav);
</script>
